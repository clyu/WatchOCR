<?xml version="1.0" encoding="utf-8"?>
<!-- Backup/transfer rules for Android 12+ (API 31+), mirroring backup_rules.xml:
     everything this app persists is excluded, because all of it is either a
     secret (the Gemini API key in the settings DataStore) or the user's own
     content (the history database and the image copies it points at). See that
     file for why each rule names a directory or spells out every sibling.

     Both sections spell the rules out rather than relying on one implying the
     other — cloud backup and device-to-device transfer are configured
     independently on this API level, and a section left empty transfers
     everything. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore" />
        <exclude domain="file" path="images" />
        <exclude domain="database" path="watchocr.db" />
        <exclude domain="database" path="watchocr.db-wal" />
        <exclude domain="database" path="watchocr.db-shm" />
        <exclude domain="database" path="watchocr.db-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore" />
        <exclude domain="file" path="images" />
        <exclude domain="database" path="watchocr.db" />
        <exclude domain="database" path="watchocr.db-wal" />
        <exclude domain="database" path="watchocr.db-shm" />
        <exclude domain="database" path="watchocr.db-journal" />
    </device-transfer>
</data-extraction-rules>
